# --- Core Django ---
SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,orbis.sebpo.net
CSRF_TRUSTED_ORIGINS=https://orbis.sebpo.net
TIME_ZONE=Asia/Dhaka

# --- Payroll field encryption ---
# Comma-separated Fernet keys, NEWEST FIRST. Every per-employee money column
# (gross salary, register amounts, tax, bank account numbers, letter input
# data) is stored as ciphertext under the first key; older keys stay listed
# until `manage.py rotate_payroll_keys` has re-saved every row. Generate with
# `manage.py generate_payroll_key`. The value below is a throwaway DEV key —
# production gets its own, which never goes in git/email/chat (the offline
# copy is a printed sheet; see docs/PAYROLL_DATA_PROTECTION_PLAN.md §3).
# Losing every key loses the data. Never set PAYROLL_PURGE_ON_MIGRATE here —
# that flag is exported by hand for the one-time conversion migrate only.
PAYROLL_FIELD_KEYS=7zAJQpr9EU4cFAOsc8US8GxCvrhoVU4_V1HXA_kqq_Q=
# Whole-file key for media blobs on Google Drive (docs/MEDIA_GOOGLE_DRIVE_PLAN.md
# §4.4). Same format/rotation as PAYROLL_FIELD_KEYS, deliberately a separate
# key. Required only when MEDIA_BACKEND=drive (and by the Drive commands);
# the filesystem backend ignores it. Throwaway DEV value below.
MEDIA_ENCRYPTION_KEYS=k9d7Zp1yQmX3vT0bN6cR4sW8uJ2hL5aE7gF1iK3oP9Y=

# --- Media storage (docs/MEDIA_GOOGLE_DRIVE_PLAN.md) ---
# filesystem (default) keeps uploads under media/. drive stores every upload
# as an encrypted, randomly-named blob in the service mailbox's Google Drive
# (srv_orbis@sebpo.com in production, srv_meals@sebpo.com for dev/test) and
# needs the two GOOGLE_DRIVE_* values from `manage.py media_drive_authorize`.
# /media/ is served by Orbis (login + authorisation) on both backends.
MEDIA_BACKEND=filesystem
GOOGLE_DRIVE_CREDENTIALS_FILE=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Local ciphertext read cache for the drive backend (disposable, LRU-pruned
# nightly by the "Prune media cache" beat job). Defaults: media_cache/, 2 GiB.
#MEDIA_CACHE_ROOT=
#MEDIA_CACHE_MAX_BYTES=2147483648
# Largest single upload accepted by the drive backend (encrypted in memory).
#MEDIA_MAX_UPLOAD_BYTES=52428800

# --- Database ---
# Set DB_ENGINE=sqlite to use a local db.sqlite3 instead of MySQL (bootstrap only).
DB_ENGINE=mysql
DB_NAME=orbis
DB_USER=orbis
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
# Seconds a DB connection is reused across requests (0 = new connection per
# request; keep the default unless MySQL max_connections pressure shows up).
DB_CONN_MAX_AGE=60

# --- Cache / background tasks ---
# Redis connection URL. Set in production (redis-server on the same VPS is
# fine): enables the shared Django cache, cached_db sessions, and the Celery
# broker. Leave blank for local dev (falls back to in-process LocMem cache;
# tasks run synchronously).
REDIS_URL=redis://127.0.0.1:6379/1
# Defaults to on when REDIS_URL is set. Requires the Celery worker + beat
# (supervisor: celery -A core worker / celery -A core beat) — see
# deploy/README.md. Set 0 to force inline task execution while keeping
# Redis caching.
TASK_QUEUE_ENABLED=1

# --- Azure AD SSO (Microsoft Entra via mozilla-django-oidc) ---
# Leave blank to keep SSO disabled (login page hides the "Sign in with Microsoft" button).
# For local testing before the dedicated Orbis Azure app reg is provisioned, you can
# borrow veridoc's app credentials — Orbis's OIDC URLs are mounted at
# /accounts/microsoft/login/[callback/] which matches veridoc's registered redirect URI
# (http://127.0.0.1:8000/accounts/microsoft/login/callback/). Stop veridoc's runserver
# first to free port 8000. The live veridoc client_secret lives in veridoc's DB
# `SocialApp.objects.get(provider='microsoft').secret`, NOT in veridoc's settings.py.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Comma-separated email domains allowed to sign in / auto-provision via SSO.
# Defense-in-depth on top of the single-tenant app registration. Defaults to
# sebpo.com when unset; set explicitly empty to disable (local testing only).
OIDC_ALLOWED_EMAIL_DOMAINS=sebpo.com

# --- TimeLy integration ---
# Bare host. The attendance client appends /api/attendance/office-presence
# itself; keeping the host without a path prefix keeps the var stable if
# TimeLy adds non-/api endpoints later. Leave both blank to disable the
# dashboard presence overlay (degrades silently).
TIMELY_API_BASE_URL=https://timely.sebpo.net
TIMELY_API_TOKEN=

# --- External write API ---
# Shared secret an external system's client sends as
# `Authorization: Token <...>` when pushing shift writes to
# /api/v1/external/shifts/batch/, and when reading the shift-type catalog /
# roster via the same TimeLy-shaped read endpoints. dsndd is the first
# consumer. Rotate independently of TIMELY_API_TOKEN.
EXTERNAL_API_TOKEN=

# --- Meal counts integration ---
# Bare host for the meals system's read-only external API. The payroll
# report's Meal column calls GET <base>/api/v1/external/meal-counts/ with
# `Authorization: Token <MEAL_COUNTS_API_TOKEN>`. Leave the token blank to
# disable the column (degrades silently — zero meal counts, not an error).
MEAL_COUNTS_API_BASE_URL=https://meals.sebpo.net
MEAL_COUNTS_API_TOKEN=

# --- TTMS daily-hours integration ---
# Bare host for ttms.sebpo.net's ops daily-hours API, backing General BPO's
# government-holiday overtime generation (manage.py generate_gh_overtime_bpo).
# POST <base>/api/v1/operations/daily-hours/ with
# `Authorization: Bearer <TTMS_API_TOKEN>`. Unlike TimeLy/meals above, an
# unset token is NOT a silent degrade here — payroll/ttms.py raises instead,
# since this data is the whole point of the command, not an optional overlay.
# Leave blank in envs that don't need this job.
TTMS_API_BASE_URL=https://ttms.sebpo.net
TTMS_API_TOKEN=

# --- Outbound email ---
# sebpo.com mail is Google Workspace (MX -> aspmx.l.google.com), so the sender
# is a Workspace service mailbox (e.g. srv_meals@sebpo.com) authenticated with
# a 16-char App Password (Google account -> Security -> 2-Step Verification ->
# App passwords; the mailbox must have 2SV on). The ordinary account password
# does NOT work for SMTP. Port 465 + EMAIL_USE_SSL=1; never set USE_TLS too.
# Dev tip: EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend prints
# mail to stdout instead of sending. Test with: manage.py sendtestemail you@sebpo.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=srv_orbis@sebpo.com
EMAIL_HOST_PASSWORD=
# What recipients see in From:. Must be the mailbox itself (or an alias Google
# lets it "Send mail as"), otherwise Gmail rewrites it to EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=Orbis <srv_orbis@sebpo.com>
# Comma-separated HR inboxes copied on HR-facing notifications.
HR_NOTIFICATION_EMAILS=

# --- Public base URL ---
# Absolute origin used in OUTBOUND links: policy signing emails, document
# approval/download emails, and the QR verify URL baked into generated PDFs.
# MUST be set in production or every emailed link points at 127.0.0.1:8000.
# Use the scheme that is actually live (http:// until TLS lands, then https://).
PUBLIC_BASE_URL=https://orbis.sebpo.net

# --- Tailwind / npm ---
NPM_BIN_PATH=/usr/bin/npm

# --- Production hardening ---
# Set to 1 ONLY when nginx/Cloudflare/etc. terminates TLS in front of gunicorn.
# When 0 (or unset), Django will not set Secure cookie flags, so plaintext-HTTP
# deployments still allow login. Flip to 1 the moment HTTPS is wired up.
BEHIND_TLS_PROXY=0
SECURE_HSTS_SECONDS=0

# --- Access log (audit app, docs/ACCESS_LOG_PLAN.md) ---
# Both optional. Logging is ON by default; set ACCESS_LOG_ENABLED=0 only as a
# kill switch. Retention is read by the nightly prune_access_log job.
# ACCESS_LOG_ENABLED=1
# ACCESS_LOG_RETENTION_DAYS=730
